{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$id" : "https://macstab.com/schemas/chaos-plan.schema.json",
  "title" : "Chaos plan",
  "description" : "A plan of the macstab chaos agent: the scenarios to activate, each a selector, an effect and an activation policy. Generated from the plan mapper; see docs/plan-schema.md.",
  "$ref" : "#/$defs/ChaosPlan",
  "$defs" : {
    "ActivationPolicy" : {
      "type" : "object",
      "properties" : {
        "activateAfterMatches" : {
          "type" : "integer"
        },
        "activeFor" : {
          "type" : "string",
          "format" : "duration"
        },
        "activeFrom" : {
          "type" : "string",
          "format" : "date-time"
        },
        "activeUntil" : {
          "type" : "string",
          "format" : "date-time"
        },
        "allowDestructiveEffects" : {
          "type" : "boolean"
        },
        "maxApplications" : {
          "type" : "integer"
        },
        "probability" : {
          "type" : "number"
        },
        "randomSeed" : {
          "type" : "integer"
        },
        "rateLimit" : {
          "$ref" : "#/$defs/RateLimit"
        },
        "replayMatches" : {
          "type" : "array",
          "items" : {
            "type" : "integer"
          }
        },
        "startMode" : {
          "type" : "string",
          "enum" : [ "AUTOMATIC", "MANUAL" ]
        }
      },
      "additionalProperties" : false
    },
    "AsyncSelector" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "async"
        },
        "operations" : {
          "type" : "array",
          "uniqueItems" : true,
          "items" : {
            "type" : "string",
            "enum" : [ "ASYNC_COMPLETE", "ASYNC_COMPLETE_EXCEPTIONALLY", "ASYNC_CANCEL" ]
          },
          "minItems" : 1
        }
      },
      "required" : [ "type", "operations" ],
      "additionalProperties" : false
    },
    "AwsSdkSelector" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "awsSdk"
        },
        "operationPattern" : {
          "$ref" : "#/$defs/NamePattern"
        },
        "operations" : {
          "type" : "array",
          "uniqueItems" : true,
          "items" : {
            "type" : "string",
            "enum" : [ "AWS_SDK_CALL" ]
          },
          "minItems" : 1
        },
        "servicePattern" : {
          "$ref" : "#/$defs/NamePattern"
        }
      },
      "required" : [ "type", "operations" ],
      "additionalProperties" : false
    },
    "ChaosEffect" : {
      "oneOf" : [ {
        "$ref" : "#/$defs/ClockSkewEffect"
      }, {
        "$ref" : "#/$defs/CodeCachePressureEffect"
      }, {
        "$ref" : "#/$defs/ConnectionResetEffect"
      }, {
        "$ref" : "#/$defs/CorruptReadEffect"
      }, {
        "$ref" : "#/$defs/DeadlockEffect"
      }, {
        "$ref" : "#/$defs/DelayEffect"
      }, {
        "$ref" : "#/$defs/DirectBufferPressureEffect"
      }, {
        "$ref" : "#/$defs/DnsAnswerEffect"
      }, {
        "$ref" : "#/$defs/DnsRewriteEffect"
      }, {
        "$ref" : "#/$defs/ErrnoEffect"
      }, {
        "$ref" : "#/$defs/ExceptionInjectionEffect"
      }, {
        "$ref" : "#/$defs/ExceptionalCompletionEffect"
      }, {
        "$ref" : "#/$defs/FinalizerBacklogEffect"
      }, {
        "$ref" : "#/$defs/GateEffect"
      }, {
        "$ref" : "#/$defs/GcPressureEffect"
      }, {
        "$ref" : "#/$defs/HeapPressureEffect"
      }, {
        "$ref" : "#/$defs/KeepAliveEffect"
      }, {
        "$ref" : "#/$defs/MetaspacePressureEffect"
      }, {
        "$ref" : "#/$defs/MonitorContentionEffect"
      }, {
        "$ref" : "#/$defs/RedirectEffect"
      }, {
        "$ref" : "#/$defs/ReferenceQueueFloodEffect"
      }, {
        "$ref" : "#/$defs/RejectEffect"
      }, {
        "$ref" : "#/$defs/ReturnValueCorruptionEffect"
      }, {
        "$ref" : "#/$defs/SafepointStormEffect"
      }, {
        "$ref" : "#/$defs/SpuriousWakeupEffect"
      }, {
        "$ref" : "#/$defs/StringInternPressureEffect"
      }, {
        "$ref" : "#/$defs/SuppressEffect"
      }, {
        "$ref" : "#/$defs/ThreadLeakEffect"
      }, {
        "$ref" : "#/$defs/ThreadLocalLeakEffect"
      }, {
        "$ref" : "#/$defs/TimeoutEffect"
      }, {
        "$ref" : "#/$defs/TornWriteEffect"
      }, {
        "$ref" : "#/$defs/TrickleEffect"
      }, {
        "$ref" : "#/$defs/VirtualThreadCarrierPinningEffect"
      } ]
    },
    "ChaosPlan" : {
      "type" : "object",
      "properties" : {
        "metadata" : {
          "$ref" : "#/$defs/Metadata"
        },
        "observability" : {
          "$ref" : "#/$defs/Observability"
        },
        "scenarios" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/ChaosScenario"
          },
          "minItems" : 1
        }
      },
      "required" : [ "scenarios" ],
      "additionalProperties" : false
    },
    "ChaosScenario" : {
      "type" : "object",
      "properties" : {
        "activationPolicy" : {
          "$ref" : "#/$defs/ActivationPolicy"
        },
        "description" : {
          "type" : "string"
        },
        "effect" : {
          "$ref" : "#/$defs/ChaosEffect"
        },
        "id" : {
          "type" : "string",
          "pattern" : "\\S"
        },
        "precedence" : {
          "type" : "integer"
        },
        "scope" : {
          "type" : "string",
          "enum" : [ "JVM", "SESSION" ]
        },
        "selector" : {
          "$ref" : "#/$defs/ChaosSelector"
        },
        "tags" : {
          "type" : "object",
          "additionalProperties" : {
            "type" : "string"
          }
        }
      },
      "required" : [ "effect", "id", "selector" ],
      "additionalProperties" : false
    },
    "ChaosSelector" : {
      "oneOf" : [ {
        "$ref" : "#/$defs/AsyncSelector"
      }, {
        "$ref" : "#/$defs/AwsSdkSelector"
      }, {
        "$ref" : "#/$defs/ClassLoadingSelector"
      }, {
        "$ref" : "#/$defs/DnsSelector"
      }, {
        "$ref" : "#/$defs/ExecutorSelector"
      }, {
        "$ref" : "#/$defs/FileIoSelector"
      }, {
        "$ref" : "#/$defs/HttpClientSelector"
      }, {
        "$ref" : "#/$defs/JdbcSelector"
      }, {
        "$ref" : "#/$defs/JvmRuntimeSelector"
      }, {
        "$ref" : "#/$defs/MessagingSelector"
      }, {
        "$ref" : "#/$defs/MethodSelector"
      }, {
        "$ref" : "#/$defs/MonitorSelector"
      }, {
        "$ref" : "#/$defs/NettySelector"
      }, {
        "$ref" : "#/$defs/NetworkSelector"
      }, {
        "$ref" : "#/$defs/NioSelector"
      }, {
        "$ref" : "#/$defs/ProcessSelector"
      }, {
        "$ref" : "#/$defs/QueueSelector"
      }, {
        "$ref" : "#/$defs/RedisSelector"
      }, {
        "$ref" : "#/$defs/RpcSelector"
      }, {
        "$ref" : "#/$defs/SchedulingSelector"
      }, {
        "$ref" : "#/$defs/ShutdownSelector"
      }, {
        "$ref" : "#/$defs/SslSelector"
      }, {
        "$ref" : "#/$defs/StressSelector"
      }, {
        "$ref" : "#/$defs/ThreadSelector"
      }, {
        "$ref" : "#/$defs/ThreadLocalSelector"
      } ]
    },
    "ClassLoadingSelector" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "classLoading"
        },
        "loaderClassPattern" : {
          "$ref" : "#/$defs/NamePattern"
        },
        "operations" : {
          "type" : "array",
          "uniqueItems" : true,
          "items" : {
            "type" : "string",
            "enum" : [ "CLASS_LOAD", "CLASS_DEFINE", "RESOURCE_LOAD" ]
          },
          "minItems" : 1
        },
        "targetNamePattern" : {
          "$ref" : "#/$defs/NamePattern"
        }
      },
      "required" : [ "type", "operations" ],
      "additionalProperties" : false
    },
    "ClockSkewEffect" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "clockSkew"
        },
        "mode" : {
          "type" : "string",
          "enum" : [ "FIXED", "DRIFT", "FREEZE", "REGRESS" ]
        },
        "skewAmount" : {
          "type" : "string",
          "format" : "duration"
        }
      },
      "required" : [ "type", "mode", "skewAmount" ],
      "additionalProperties" : false
    },
    "CodeCachePressureEffect" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "codeCachePressure"
        },
        "classCount" : {
          "type" : "integer"
        },
        "methodsPerClass" : {
          "type" : "integer"
        }
      },
      "required" : [ "type", "classCount", "methodsPerClass" ],
      "additionalProperties" : false
    },
    "ConnectionResetEffect" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "connectionReset"
        }
      },
      "required" : [ "type" ],
      "additionalProperties" : false
    },
    "CorruptReadEffect" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "corruptRead"
        }
      },
      "required" : [ "type" ],
      "additionalProperties" : false
    },
    "DeadlockEffect" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "deadlock"
        },
        "acquisitionDelay" : {
          "type" : "string",
          "format" : "duration"
        },
        "participantCount" : {
          "type" : "integer"
        }
      },
      "required" : [ "type", "participantCount" ],
      "additionalProperties" : false
    },
    "DelayEffect" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "delay"
        },
        "maxDelay" : {
          "type" : "string",
          "format" : "duration"
        },
        "minDelay" : {
          "type" : "string",
          "format" : "duration"
        }
      },
      "required" : [ "type", "maxDelay", "minDelay" ],
      "additionalProperties" : false
    },
    "DirectBufferPressureEffect" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "directBufferPressure"
        },
        "bufferSizeBytes" : {
          "type" : "integer"
        },
        "registerCleaner" : {
          "type" : "boolean"
        },
        "totalBytes" : {
          "type" : "integer"
        }
      },
      "required" : [ "type", "bufferSizeBytes", "totalBytes" ],
      "additionalProperties" : false
    },
    "DnsAnswerEffect" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "dnsAnswer"
        },
        "family" : {
          "type" : "string",
          "enum" : [ "IPV4", "IPV6" ]
        },
        "limit" : {
          "type" : "integer"
        },
        "override" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          },
          "minItems" : 1
        },
        "shuffle" : {
          "type" : "boolean"
        }
      },
      "required" : [ "type" ],
      "additionalProperties" : false
    },
    "DnsRewriteEffect" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "dnsRewrite"
        },
        "host" : {
          "type" : "string",
          "pattern" : "\\S"
        }
      },
      "required" : [ "type", "host" ],
      "additionalProperties" : false
    },
    "DnsSelector" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "dns"
        },
        "hostnamePattern" : {
          "$ref" : "#/$defs/NamePattern"
        },
        "operations" : {
          "type" : "array",
          "uniqueItems" : true,
          "items" : {
            "type" : "string",
            "enum" : [ "DNS_RESOLVE", "DNS_ANSWER", "DNS_REVERSE" ]
          },
          "minItems" : 1
        }
      },
      "required" : [ "type", "operations" ],
      "additionalProperties" : false
    },
    "ErrnoEffect" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "errno"
        },
        "errno" : {
          "type" : "string",
          "enum" : [ "ECONNREFUSED", "ETIMEDOUT", "ECONNRESET", "EHOSTUNREACH", "ENETUNREACH", "EPIPE", "EADDRINUSE", "EADDRNOTAVAIL", "ENOTCONN", "ENOBUFS", "EINVAL", "EOPNOTSUPP", "EAFNOSUPPORT", "EPROTONOSUPPORT", "ENOSPC", "EDQUOT", "EROFS", "EACCES", "ENOENT", "EIO", "EMFILE", "ENFILE", "EAGAIN", "ENOMEM" ]
        }
      },
      "required" : [ "type", "errno" ],
      "additionalProperties" : false
    },
    "ExceptionInjectionEffect" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "exceptionInjection"
        },
        "exceptionClassName" : {
          "type" : "string",
          "pattern" : "\\S"
        },
        "message" : {
          "type" : "string",
          "pattern" : "\\S"
        },
        "withStackTrace" : {
          "type" : "boolean"
        }
      },
      "required" : [ "type", "exceptionClassName", "message" ],
      "additionalProperties" : false
    },
    "ExceptionalCompletionEffect" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "exceptionalCompletion"
        },
        "failureKind" : {
          "type" : "string",
          "enum" : [ "REJECTED", "TIMEOUT", "ILLEGAL_STATE", "CLASS_NOT_FOUND", "IO", "INTERRUPTED", "RUNTIME", "SECURITY" ]
        },
        "message" : {
          "type" : "string",
          "pattern" : "\\S"
        }
      },
      "required" : [ "type", "failureKind", "message" ],
      "additionalProperties" : false
    },
    "ExecutorSelector" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "executor"
        },
        "executorClassPattern" : {
          "$ref" : "#/$defs/NamePattern"
        },
        "operations" : {
          "type" : "array",
          "uniqueItems" : true,
          "items" : {
            "type" : "string",
            "enum" : [ "EXECUTOR_SUBMIT", "EXECUTOR_WORKER_RUN", "EXECUTOR_SHUTDOWN", "EXECUTOR_AWAIT_TERMINATION", "FORK_JOIN_TASK_RUN" ]
          },
          "minItems" : 1
        },
        "scheduledOnly" : {
          "type" : "boolean"
        },
        "taskClassPattern" : {
          "$ref" : "#/$defs/NamePattern"
        }
      },
      "required" : [ "type", "operations" ],
      "additionalProperties" : false
    },
    "FileIoSelector" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "fileIo"
        },
        "maxBytes" : {
          "type" : "integer"
        },
        "minBytes" : {
          "type" : "integer"
        },
        "operations" : {
          "type" : "array",
          "uniqueItems" : true,
          "items" : {
            "type" : "string",
            "enum" : [ "FILE_IO_READ", "FILE_IO_WRITE", "FILE_IO_SYNC", "FILE_IO_TRUNCATE", "FILE_IO_DELETE", "FILE_IO_MOVE", "FILE_IO_OPEN", "FILE_IO_MAP", "FILE_IO_CLOSE", "FILE_IO_MOVE_TARGET" ]
          },
          "minItems" : 1
        },
        "pathPattern" : {
          "$ref" : "#/$defs/PathPattern"
        }
      },
      "required" : [ "type", "operations" ],
      "additionalProperties" : false
    },
    "FinalizerBacklogEffect" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "finalizerBacklog"
        },
        "finalizerDelay" : {
          "type" : "string",
          "format" : "duration"
        },
        "objectCount" : {
          "type" : "integer"
        }
      },
      "required" : [ "type", "finalizerDelay", "objectCount" ],
      "additionalProperties" : false
    },
    "GateEffect" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "gate"
        },
        "maxBlock" : {
          "type" : "string",
          "format" : "duration"
        }
      },
      "required" : [ "type" ],
      "additionalProperties" : false
    },
    "GcPressureEffect" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "gcPressure"
        },
        "allocationRateBytesPerSecond" : {
          "type" : "integer"
        },
        "duration" : {
          "type" : "string",
          "format" : "duration"
        },
        "objectSizeBytes" : {
          "type" : "integer"
        },
        "promoteToOldGen" : {
          "type" : "boolean"
        }
      },
      "required" : [ "type", "allocationRateBytesPerSecond", "duration" ],
      "additionalProperties" : false
    },
    "HeapPressureEffect" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "heapPressure"
        },
        "bytes" : {
          "type" : "integer"
        },
        "chunkSizeBytes" : {
          "type" : "integer"
        }
      },
      "required" : [ "type", "bytes", "chunkSizeBytes" ],
      "additionalProperties" : false
    },
    "HttpClientSelector" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "httpClient"
        },
        "operations" : {
          "type" : "array",
          "uniqueItems" : true,
          "items" : {
            "type" : "string",
            "enum" : [ "HTTP_CLIENT_SEND", "HTTP_CLIENT_SEND_ASYNC" ]
          },
          "minItems" : 1
        },
        "urlPattern" : {
          "$ref" : "#/$defs/NamePattern"
        }
      },
      "required" : [ "type", "operations" ],
      "additionalProperties" : false
    },
    "JdbcSelector" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "jdbc"
        },
        "operations" : {
          "type" : "array",
          "uniqueItems" : true,
          "items" : {
            "type" : "string",
            "enum" : [ "JDBC_CONNECTION_ACQUIRE", "JDBC_STATEMENT_EXECUTE", "JDBC_PREPARED_STATEMENT", "JDBC_TRANSACTION_COMMIT", "JDBC_TRANSACTION_ROLLBACK", "R2DBC_STATEMENT_EXECUTE" ]
          },
          "minItems" : 1
        },
        "targetPattern" : {
          "$ref" : "#/$defs/NamePattern"
        }
      },
      "required" : [ "type", "operations" ],
      "additionalProperties" : false
    },
    "JvmRuntimeSelector" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "jvmRuntime"
        },
        "operations" : {
          "type" : "array",
          "uniqueItems" : true,
          "items" : {
            "type" : "string",
            "enum" : [ "SYSTEM_CLOCK_MILLIS", "SYSTEM_CLOCK_NANOS", "INSTANT_NOW", "CLOCK_READ", "LOCAL_DATE_TIME_NOW", "ZONED_DATE_TIME_NOW", "DATE_NEW", "SYSTEM_GC_REQUEST", "SYSTEM_EXIT_REQUEST", "REFLECTION_INVOKE", "DIRECT_BUFFER_ALLOCATE", "OBJECT_DESERIALIZE", "OBJECT_SERIALIZE", "NATIVE_LIBRARY_LOAD", "JNDI_LOOKUP", "JMX_INVOKE", "JMX_GET_ATTR", "ZIP_INFLATE", "ZIP_DEFLATE" ]
          },
          "minItems" : 1
        }
      },
      "required" : [ "type", "operations" ],
      "additionalProperties" : false
    },
    "KeepAliveEffect" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "keepAlive"
        },
        "daemon" : {
          "type" : "boolean"
        },
        "heartbeat" : {
          "type" : "string",
          "format" : "duration"
        },
        "threadName" : {
          "type" : "string",
          "pattern" : "\\S"
        }
      },
      "required" : [ "type", "heartbeat", "threadName" ],
      "additionalProperties" : false
    },
    "MessagingSelector" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "messaging"
        },
        "destinationPattern" : {
          "$ref" : "#/$defs/NamePattern"
        },
        "operations" : {
          "type" : "array",
          "uniqueItems" : true,
          "items" : {
            "type" : "string",
            "enum" : [ "MESSAGE_SEND", "MESSAGE_RECEIVE" ]
          },
          "minItems" : 1
        }
      },
      "required" : [ "type", "operations" ],
      "additionalProperties" : false
    },
    "Metadata" : {
      "type" : "object",
      "properties" : {
        "description" : {
          "type" : "string"
        },
        "name" : {
          "type" : "string",
          "pattern" : "\\S"
        }
      },
      "required" : [ "name" ],
      "additionalProperties" : false
    },
    "MetaspacePressureEffect" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "metaspacePressure"
        },
        "fieldsPerClass" : {
          "type" : "integer"
        },
        "generatedClassCount" : {
          "type" : "integer"
        },
        "retain" : {
          "type" : "boolean"
        }
      },
      "required" : [ "type", "generatedClassCount" ],
      "additionalProperties" : false
    },
    "MethodSelector" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "method"
        },
        "classPattern" : {
          "$ref" : "#/$defs/NamePattern"
        },
        "methodNamePattern" : {
          "$ref" : "#/$defs/NamePattern"
        },
        "operations" : {
          "type" : "array",
          "uniqueItems" : true,
          "items" : {
            "type" : "string",
            "enum" : [ "METHOD_ENTER", "METHOD_EXIT" ]
          },
          "minItems" : 1
        },
        "signaturePattern" : {
          "$ref" : "#/$defs/NamePattern"
        }
      },
      "required" : [ "type", "operations" ],
      "additionalProperties" : false
    },
    "MonitorContentionEffect" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "monitorContention"
        },
        "contendingThreadCount" : {
          "type" : "integer"
        },
        "lockHoldDuration" : {
          "type" : "string",
          "format" : "duration"
        },
        "unfair" : {
          "type" : "boolean"
        }
      },
      "required" : [ "type", "contendingThreadCount", "lockHoldDuration" ],
      "additionalProperties" : false
    },
    "MonitorSelector" : {
      "type" : "object",
      "properties" : {
